{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*", "__mocks__/**/*"],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "src/**/*.test.ts",
    "src/test.ts",
    "src/test-support/**/*",
    "test/**/*"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "lib",
    "declarationDir": "temp/types",
    "declarationMap": true,
    "sourceMap": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@blurengine/bebe": ["./src/index.ts"],
      "@blurengine/bebe/bedrock": ["./src/bedrock/index.ts"],
      "@blurengine/bebe/catalog": ["./src/catalog/index.ts"],
      "@blurengine/bebe/features/fishing": ["./src/features/fishing/index.ts"],
      "@blurengine/bebe/internal/link/bds": ["./src/internal/link/bds.ts"],
      "@blurengine/bebe/internal/audio/player": [
        "./src/internal/audio/player.ts"
      ],
      "@blurengine/bebe/internal/zones/editor": [
        "./src/internal/zones/editor.ts"
      ],
      "@blurengine/bebe/maths": ["./src/maths/index.ts"],
      "@blurengine/bebe/tooling/node": ["./src/tooling/node.ts"]
    }
  }
}
