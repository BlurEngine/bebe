{
  "extends": "./tsconfig.base.json",
  "include": ["src/**/*", "__mocks__/**/*"],
  "exclude": [
    "dist",
    "build",
    "node_modules",
    "src/**/*.test.ts",
    "src/test.ts",
    "src/test-support/**/*",
    "test/**/*"
  ],
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "lib",
    "declarationDir": "temp/types",
    "declarationMap": true,
    "sourceMap": true,
    "module": "node16",
    "moduleResolution": "node16",
    "lib": ["ES2023", "DOM"],
    "paths": {
      "@blurengine/bebe": ["./src/index.ts"],
      "@blurengine/bebe/bedrock": ["./src/bedrock/index.ts"],
      "@blurengine/bebe/maths": ["./src/maths/index.ts"]
    }
  }
}
